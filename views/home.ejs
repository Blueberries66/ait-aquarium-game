<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Aquarium Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-gradient-to-b from-sky-100 to-cyan-50 min-h-screen text-slate-800">
    <main class="max-w-4xl mx-auto px-6 py-12">
      <div class="text-center mb-10">
        <h1 class="text-5xl font-bold text-sky-700 mb-3">Aquarium</h1>
        <p class="text-lg text-slate-600">Build your tank, collect fish, and grow your aquarium.</p>
      </div>

      <section class="bg-white rounded-3xl shadow-lg p-8 border border-sky-100">
        <h2 class="text-3xl font-semibold mb-4"><%= tank.name %></h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-sky-50 p-5 border border-sky-100">
            <p class="text-sm uppercase tracking-wide text-slate-500 mb-1">Coins</p>
            <p class="text-3xl font-bold text-sky-700"><%= tank.coins %></p>
          </div>
          <div class="rounded-2xl bg-emerald-50 p-5 border border-emerald-100">
            <p class="text-sm uppercase tracking-wide text-slate-500 mb-1">Fish in Tank</p>
            <p class="text-3xl font-bold text-emerald-600"><%= tank.fish.length %> / <%= tank.capacity %></p>
          </div>
        </div>
      </section>

      <nav class="mt-8 flex flex-col sm:flex-row gap-4">
        <a
          href="/shop"
          class="inline-block rounded-2xl bg-sky-600 px-6 py-4 text-white text-center font-semibold shadow hover:bg-sky-700 transition"
        >
          Go to Shop
        </a>
        <a
          href="/inventory"
          class="inline-block rounded-2xl bg-white px-6 py-4 text-sky-700 text-center font-semibold border border-sky-200 shadow hover:bg-sky-100 transition"
        >
          View Inventory
        </a>
      </nav>
    </main>
  </body>
</html>