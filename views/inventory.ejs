<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Inventory</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-sky-50 min-h-screen text-slate-800">
    <main class="max-w-4xl mx-auto px-6 py-10">
      <h1 class="text-4xl font-bold text-sky-700 mb-8">Your Tank Inventory</h1>

      <section class="bg-white rounded-2xl shadow-md p-6 mb-6 border border-sky-100">
        <h2 class="text-2xl font-semibold mb-4"><%= tank.name %></h2>
        <div class="space-y-2 text-lg">
          <p>Coins remaining: <strong class="text-sky-700"><%= tank.coins %></strong></p>
          <p>Fish count: <strong><%= tank.fish.length %> / <%= tank.capacity %></strong></p>
          <p>Total click bonus from fish: <strong class="text-emerald-600"><%= totalClickBonus %></strong></p>
        </div>
      </section>

      <section class="bg-white rounded-2xl shadow-md p-6 border border-sky-100">
        <h2 class="text-2xl font-semibold mb-4">Owned Fish</h2>

        <% if (tank.fish.length === 0) { %>
          <p class="text-slate-500">No fish yet.</p>
        <% } else { %>
          <ul class="space-y-3">
            <% tank.fish.forEach(fish => { %>
              <li class="rounded-xl border border-slate-200 p-4 bg-slate-50">
                <p class="text-lg font-semibold text-sky-700"><%= fish.name %></p>
                <p class="text-slate-600"><%= fish.species %></p>
                <p class="text-sm text-slate-500 mt-1">
                  Cost: <%= fish.cost %> • Click bonus: <%= fish.clickBonus %>
                </p>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <nav class="mt-8 flex gap-4">
        <a
          href="/"
          class="inline-block rounded-xl bg-sky-600 px-5 py-3 text-white font-medium shadow hover:bg-sky-700 transition"
        >
          Home
        </a>
        <a
          href="/shop"
          class="inline-block rounded-xl bg-white px-5 py-3 text-sky-700 font-medium border border-sky-200 shadow hover:bg-sky-100 transition"
        >
          Back to Shop
        </a>
      </nav>
    </main>
  </body>
</html>