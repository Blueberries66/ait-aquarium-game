<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Shop</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-sky-50 min-h-screen text-slate-800">
    <main class="max-w-4xl mx-auto px-6 py-10">

      <h1 class="text-4xl font-bold text-sky-700 mb-6">Shop</h1>

      <!-- Tank selector -->
      <div class="bg-white rounded-2xl shadow p-5 border border-sky-100 mb-8">
        <label class="block text-sm font-medium text-slate-600 mb-2">Buying for:</label>
        <div class="flex flex-wrap gap-3">
          <% tanks.forEach(t => { %>
            <a href="/shop?tankId=<%= t._id %>"
              class="rounded-xl px-4 py-2 font-semibold border transition
                <%= t._id.toString() === tank._id.toString()
                  ? 'bg-sky-600 text-white border-sky-600'
                  : 'bg-white text-sky-700 border-sky-200 hover:bg-sky-50' %>">
              <%= t.name %>
              (<%= t.fish.length %>/<%= t.capacity %>)
            </a>
          <% }) %>
        </div>
        <p class="mt-3 text-slate-500 text-sm">
          Coins: <strong class="text-sky-700"><%= coins %></strong>
          &nbsp;|&nbsp;
          Space: <strong><%= tank.fish.length %> / <%= tank.capacity %></strong>
        </p>
      </div>

      <% if (errorMessage) { %>
        <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-700">
          <%= errorMessage %>
        </div>
      <% } %>

      <!-- Fish Catalog -->
      <h2 class="text-2xl font-semibold mb-4">Fish</h2>
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 mb-10">
        <% fishCatalog.forEach(fish => { %>
          <div class="bg-white rounded-2xl shadow p-5 border border-sky-100 flex flex-col gap-3">
            <div class="h-24 rounded-xl bg-sky-100 flex items-center justify-center text-5xl">
              <% if (fish.imagePath) { %>
                <img src="<%= fish.imagePath %>" alt="<%= fish.name %>" class="h-full object-contain p-2" />
              <% } else { %>
                [fish]
              <% } %>
            </div>
            <div>
              <p class="font-bold text-lg text-sky-700"><%= fish.name %></p>
              <p class="text-sm text-slate-400 italic"><%= fish.species %></p>
              <p class="text-sm mt-1">
                +<%= fish.clickBonus %>/click &nbsp;-&nbsp;
                <span class="capitalize font-medium
                  <%= fish.rarity === 'legendary' ? 'text-yellow-500' :
                      fish.rarity === 'rare'      ? 'text-purple-500' :
                                                    'text-slate-400'  %>">
                  <%= fish.rarity %>
                </span>
              </p>
            </div>
            <form action="/shop/buy-fish" method="POST" class="mt-auto">
              <input type="hidden" name="templateId" value="<%= fish._id %>" />
              <input type="hidden" name="tankId"     value="<%= tank._id %>" />
              <button type="submit"
                class="w-full rounded-xl bg-sky-600 py-2 text-white font-semibold hover:bg-sky-700 transition">
                Buy - <%= fish.cost %> coins
              </button>
            </form>
          </div>
        <% }) %>
      </div>

      <!-- New Tank -->
      <h2 class="text-2xl font-semibold mb-4">New Tank</h2>
      <div class="bg-white rounded-2xl shadow p-5 border border-sky-100 flex flex-col gap-3 max-w-sm mb-10">
        <div class="h-24 rounded-xl bg-blue-50 flex items-center justify-center text-5xl">
          [tank]
        </div>
        <div>
          <p class="font-bold text-lg text-sky-700">New Tank</p>
          <p class="text-sm text-slate-500">Capacity: 10 fish</p>
          <p class="text-sm text-slate-500">Price increases with each tank you own.</p>
        </div>
        <form action="/shop/buy-tank" method="POST" class="flex flex-col gap-3">
          <input
            type="text"
            name="tankName"
            placeholder="Name your tank..."
            maxlength="30"
            required
            class="w-full rounded-xl border border-slate-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-400"
          />
          <button type="submit"
            class="w-full rounded-xl bg-sky-600 py-2 text-white font-semibold hover:bg-sky-700 transition">
            Buy - <%= tankCost %> coins
          </button>
        </form>
      </div>

      <nav class="flex gap-4">
        <a href="/"
          class="rounded-xl bg-white px-5 py-3 text-sky-700 border border-sky-200 shadow hover:bg-sky-50 transition">
          Home
        </a>
      </nav>

    </main>
  </body>
</html>
